{
  "name": "@taskhelm/web",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "build": "node scripts/clean-runtime.mjs && next build && node scripts/package-runtime.mjs",
    "dev": "next dev --port 4100",
    "package-runtime": "node scripts/package-runtime.mjs",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "node scripts/clean-runtime.mjs && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@taskhelm/core": "0.2.1",
    "@taskhelm/supervisor": "0.2.1",
    "mermaid": "^11.12.0",
    "motion": "^12.38.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
