{
  "name": "taskhelm",
  "version": "0.1.12",
  "description": "Local-first visual workbench for parallel git-worktree work — manage tasks, branches, worktrees, ports, and pooled dev servers from one dashboard on your machine.",
  "keywords": [
    "git-worktree",
    "developer-tools",
    "local-first",
    "task-management",
    "dev-server",
    "workbench",
    "parallel-development",
    "monorepo",
    "nextjs",
    "cli",
    "sqlite"
  ],
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaka-123-D/TaskHelm.git"
  },
  "bugs": {
    "url": "https://github.com/Kaka-123-D/TaskHelm/issues"
  },
  "homepage": "https://github.com/Kaka-123-D/TaskHelm#readme",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "taskhelm": "./bin/taskhelm.js"
  },
  "files": [
    "bin",
    "README.md",
    "scripts/prepare-installed-runtime.mjs",
    "packages/web/package.json",
    "packages/web/next-env.d.ts",
    "packages/web/next.config.mjs",
    "packages/web/postcss.config.mjs",
    "packages/web/tsconfig.json",
    "packages/web/scripts",
    "packages/web/src",
    "!packages/web/src/**/*.test.ts",
    "!packages/web/src/**/*.test.tsx"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev": "turbo dev"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@taskhelm/cli": "workspace:*",
    "@taskhelm/core": "workspace:*",
    "@taskhelm/supervisor": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.8.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mermaid": "^11.12.0",
    "motion": "^12.38.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
